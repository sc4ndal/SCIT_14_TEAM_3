[Unit]
Description=Buulgyeong (SCIT_14_TEAM_3) Spring Boot
After=network.target mysql.service

[Service]
User=ubuntu
WorkingDirectory=/opt/buulgyeong
# 키/DB 정보는 /opt/buulgyeong/application-local.properties (chmod 600) 에 둔다.
# 운영 설정(도메인, 캐시, 로그 레벨 등)도 이 파일 하나에 같이 넣는다.
# 메모리가 작은 서버(1~2GB)라 힙을 제한한다. 서버 사양에 맞게 조정.
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /opt/buulgyeong/app.jar --spring.config.additional-location=file:/opt/buulgyeong/ --spring.profiles.active=local
SuccessExitStatus=143
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
